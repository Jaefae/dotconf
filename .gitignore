# Stale XDG data/cache dirs. Nothing writes these any more: they were populated
# when nushell's env.nu pointed XDG_DATA_HOME at this repo. XDG_DATA_HOME is now
# unset and nvim resolves stdpath('data') to the platform default. Kept ignored
# so a stray tool re-creating them doesn't end up staged.
share/
cache/

